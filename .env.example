# GENERATION SETTINGS (OpenRouter)
# Used for the massive generation phase.
LLM_MODE=openrouter
OPENROUTER_API_KEY=sk-or-your-key-here
# Primary model for generation
OPENROUTER_MODEL_A=deepseek/deepseek-chat

# PIPELINE CAPACITY
# Total number of concurrent asyncio workers
BATCH_SIZE=40
# Max concurrent requests for OpenRouter generation
GEN_SEMAPHORE=28
# Max concurrent requests per Judge provider
JUDGE_SEMAPHORE=4

# DATABASE
REDIS_HOST=localhost
REDIS_PORT=6379

# JUDGE SETTINGS
USE_SINGLE_JUDGE_PROVIDER=true

# Provider to use in test-mode
SINGLE_JUDGE_PROVIDER=openrouter
SINGLE_JUDGE_MODEL=deepseek/deepseek-chat

# Disable the rewrite loop (true = active, false = only pass/fail)
ENABLE_REWRITE=false

# Judge 1: OpenAI
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o

# Judge 2: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Judge 3: Google Gemini
# Note: This uses REST API via aiohttp to avoid protobuf conflicts
GEMINI_API_KEY=AIzaSy-your-google-key
GEMINI_MODEL=gemini

# Provider selection for the rewriter logic: openai / anthropic / gemini
REWRITER_PROVIDER=openai

# PATHS
INPUT_FILE=data/v4_atomic_all_agg.csv
OUTPUT_FILE=data/forensic_atomic_final.csv
JUDGEMENT_FILE=data/judgements_log.csv